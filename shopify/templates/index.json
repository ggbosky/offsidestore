      "settings": {
        "heading": "Vytvoř si svůj náramek",
        "text": "<p>Klub, barva, písmena, zakončení. Cena se přepočítává v reálném čase — vidíš ji rovnou v tlačítku.</p>",
        "currency_suffix": "Kč",
        "palette": "#111111,#FFFFFF,#B01E28,#0B4EA2,#3FA9E0,#0F9D4F,#F2C300,#FF6B00,#C0C0C0,#7A4A2B",
