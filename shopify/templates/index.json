    "os_vznik": {
      "type": "offside-jak-vznika",
      "blocks": {
        "v1": {
          "type": "krok",
          "settings": {
            "title": "Tkanička z brusle",
            "text": "<p>Stejný materiál, jaký drží brusli na noze. Voskované vlákno, které snese pot, mráz i vodu — proto náramek nezplihne po týdnu nošení.</p>"
          }
        },
        "v2": {
          "type": "krok",
          "settings": {
            "title": "Barva podle dresu",
            "text": "<p>Odstín ladíme podle aktuálního dresu, ne podle nejbližší barvy ze skladu. Když si vezmeš náramek na stadion, sedí s tím, co máš na sobě.</p>"
          }
        },
        "v3": {
          "type": "krok",
          "settings": {
            "title": "Zkratka v pletení",
            "text": "<p>Znaky nejsou nalepené ani potištěné. Jsou navlečené na tkaničce a zapletené do splétání, takže se nemají jak setřít.</p>"
          }
        },
        "v4": {
          "type": "krok",
          "settings": {
            "title": "Splétáno rukou",
            "text": "<p>Každý kus splétáme ručně kus po kuse. Drobné odchylky v napětí splétání nejsou vada — jsou důkaz, že to nedělal stroj.</p>"
          }
        }
      },
      "block_order": [
        "v1",
        "v2",
        "v3",
        "v4"
      ],
      "settings": {
        "heading": "Jak vzniká",
        "accent": "#ec0016"
      }
    },
    "os_faq": {
      "type": "offside-faq",
      "blocks": {
        "q1": {
          "type": "otazka",
          "settings": {
            "question": "Z čeho je náramek vyrobený?",
            "answer": "<p>Z originálních hokejových tkaniček — stejného materiálu, jaký hráči používají v bruslích. Tkanička je zkrácená, zapletená do náramku a zakončená kovovou koncovkou.</p>"
          }
        },
        "q2": {
          "type": "otazka",
          "settings": {
            "question": "Kolik znaků si můžu nechat vyplést?",
            "answer": "<p>V ceně 290 Kč jsou tři znaky. Každý další stojí 12 Kč, maximum je dvanáct znaků.</p>"
          }
        },
        "q3": {
          "type": "otazka",
          "settings": {
            "question": "Jaký je rozdíl mezi univerzálním zakončením a velikostí na míru?",
            "answer": "<p>Univerzální má posuvný uzel — délku si doladíš na ruce sám a sedne prakticky komukoliv. Zakončení na míru je pevné a šije se na konkrétní velikost S, M nebo L.</p>"
          }
        },
        "q4": {
          "type": "otazka",
          "settings": {
            "question": "Jak si vyberu velikost?",
            "answer": "<p>S odpovídá obvodu zápěstí 16–17 cm, M 17–19 cm a L 19–21 cm. Změř obvod provázkem a přidej zhruba centimetr na volnost.</p>"
          }
        },
        "q5": {
          "type": "otazka",
          "settings": {
            "question": "Kdy mi náramek dorazí?",
            "answer": "<p>Každý kus splétáme ručně, takže termín odeslání závisí na velikosti objednávky. Konkrétní termín ti potvrdíme e-mailem hned po objednání.</p>"
          }
        },
        "q6": {
          "type": "otazka",
          "settings": {
            "question": "Vydrží náramek ve vodě?",
            "answer": "<p>Ano. Tkanička i koncovka snesou déšť i sprchu. Doporučujeme jen vyhnout se dlouhému máčení ve slané vodě a chlóru.</p>"
          }
        },
        "q7": {
          "type": "otazka",
          "settings": {
            "question": "Můžu ho vrátit?",
            "answer": "<p>Standardní edice do 30 dnů bez udání důvodu. U kusů s vlastní zkratkou na míru vracíme peníze při vadě výroby.</p>"
          }
        }
      },
