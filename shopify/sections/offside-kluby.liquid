{%- comment -%}
  OffsideStore — KOMU FANDÍŠ

  Dlazdice se berou z kolekce: kazdy produkt v ni je jeden klub. Na dlazdici
  je fotka naramku, a dokud fotka neni, zkratka klubu na klubovem prechodu.
  Kliknuti vybere klub, tlacitko vlozi produkt do kosiku pres Cart API.

  Barvy se ctou z metafieldu produktu (vsechny nepovinne):
    custom.club_abbr  — zkratka, napr. SPA
    custom.club_from  — zacatek prechodu, hex
    custom.club_to    — konec prechodu, hex
    custom.club_ink   — barva zkratky, hex
{%- endcomment -%}

{{ 'offside.css' | asset_url | stylesheet_tag }}

{%- assign kolekce = section.settings.collection -%}

<section
  class="os os-section"
  id="os-kluby"
  style="--os-accent: {{ section.settings.accent }};"
>
  <div class="os__wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="os__display os__h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if kolekce != blank and kolekce.products_count > 0 -%}
      <div class="os-kluby__grid">
        {%- for produkt in kolekce.products limit: section.settings.max_products -%}
          {%- assign varianta = produkt.selected_or_first_available_variant -%}

          {%- assign zkratka = produkt.metafields.custom.club_abbr -%}
          {%- if zkratka == blank -%}
            {%- assign zkratka = produkt.title | split: ' ' | last | slice: 0, 3 -%}
          {%- endif -%}

          {%- assign od = produkt.metafields.custom.club_from | default: section.settings.default_from -%}
          {%- assign do = produkt.metafields.custom.club_to | default: section.settings.default_to -%}
          {%- assign inkoust = produkt.metafields.custom.club_ink | default: '#ffffff' -%}

          <button
            type="button"
            class="os-klub{% if produkt.featured_image %} os-klub--foto{% endif %}"
            data-os-klub
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            data-accent="{{ od }}"
            data-name="{{ produkt.title | escape }}"
            data-abbr="{{ zkratka | upcase | escape }}"
            data-url="{{ produkt.url }}"
            data-variant="{% if varianta %}{{ varianta.id }}{% endif %}"
            data-cena="{% if varianta %}{{ varianta.price | money }}{% endif %}"
            data-skladem="{% if varianta and varianta.available %}1{% else %}0{% endif %}"
            style="background: linear-gradient(135deg, {{ od }} 0%, {{ do }} 100%); color: {{ inkoust }};"
          >
            {%- if produkt.featured_image -%}
              {{
                produkt.featured_image
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  class: 'os-klub__foto',
                  sizes: '(max-width: 640px) 33vw, 220px',
                  widths: '220, 400, 600',
                  alt: produkt.title
              }}
            {%- else -%}
              <span class="os-klub__abbr">{{ zkratka | upcase }}</span>
            {%- endif -%}
          </button>
        {%- endfor -%}
      </div>

      {%- assign prvni = kolekce.products.first -%}
      {%- assign prvni_varianta = prvni.selected_or_first_available_variant -%}
      <div class="os-kluby__panel">
        <div>
          <p class="os-kluby__panel-name" data-os-panel-name>{{ prvni.title }}</p>
          <p class="os-kluby__panel-note" data-os-panel-note>
            {{ section.settings.note }}
          </p>
        </div>

        <div class="os-kluby__akce">
          <span class="os-kluby__cena" data-os-panel-cena>
            {%- if prvni_varianta -%}{{ prvni_varianta.price | money }}{%- endif -%}
          </span>

          <button type="button" class="os__btn os__btn--accent" data-os-panel-koupit>
            <span data-os-panel-popisek>{{ section.settings.button_label }}</span>
          </button>

          <a class="os-kluby__detail" data-os-panel-detail href="{{ prvni.url }}">
            Detail &rarr;
          </a>
        </div>
      </div>

      <p class="os-kluby__stav" data-os-panel-stav role="status"></p>
    {%- else -%}
      <div class="os-produkty__empty">
        Vyber v nastavení sekce kolekci s náramky. Každý produkt v ní se tu
        zobrazí jako jeden klub.
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('os-kluby');
    if (!root) return;

    var tiles = root.querySelectorAll('[data-os-klub]');
    if (!tiles.length) return;

    var name = root.querySelector('[data-os-panel-name]');
    var cena = root.querySelector('[data-os-panel-cena]');
    var detail = root.querySelector('[data-os-panel-detail]');
    var koupit = root.querySelector('[data-os-panel-koupit]');
    var popisek = root.querySelector('[data-os-panel-popisek]');
    var stav = root.querySelector('[data-os-panel-stav]');
    var popisekZaklad = {{ section.settings.button_label | default: 'Koupit' | json }};
    var vybrany = tiles[0];

    /* Bila na zlute neni videt — barvu textu urcime podle jasu podkladu. */
    function textNaBarve(hex) {
      var m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex || '');
      if (!m) return '#ffffff';
      var jas =
        (0.2126 * parseInt(m[1], 16) +
          0.7152 * parseInt(m[2], 16) +
          0.0722 * parseInt(m[3], 16)) / 255;
      return jas > 0.6 ? '#0a0a0a' : '#ffffff';
    }

    function vyber(tile) {
      vybrany = tile;
      tiles.forEach(function (t) {
        t.setAttribute('aria-pressed', t === tile ? 'true' : 'false');
      });

      var akcent = tile.dataset.accent || '#ec0016';
      root.style.setProperty('--os-accent', akcent);
      root.style.setProperty('--os-on-accent', textNaBarve(akcent));

      if (name) name.textContent = tile.dataset.name || '';
      if (cena) cena.textContent = tile.dataset.cena || '';
      if (detail) detail.setAttribute('href', tile.dataset.url || '#');
      if (popisek) popisek.textContent = popisekZaklad + ' ' + (tile.dataset.abbr || '');
      if (stav) stav.textContent = '';
      if (koupit) koupit.disabled = !(tile.dataset.variant && tile.dataset.skladem === '1');
    }

    tiles.forEach(function (tile) {
      tile.addEventListener('click', function () { vyber(tile); });
    });

    if (koupit) {
      koupit.addEventListener('click', function () {
        var id = vybrany && vybrany.dataset.variant;
        if (!id) return;

        koupit.disabled = true;
        if (stav) stav.textContent = 'Přidávám do košíku…';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: [{ id: Number(id), quantity: 1 }] }),
        })
          .then(function (r) { if (!r.ok) throw new Error('cart'); return r.json(); })
          .then(function () {
            if (stav) stav.textContent = 'Přidáno do košíku, otevírám ho…';
            setTimeout(function () { window.location.href = '/cart'; }, 600);
          })
          .catch(function () {
            if (stav) stav.textContent = 'Nepodařilo se přidat do košíku. Zkus to prosím znovu.';
            koupit.disabled = false;
          });
      });
    }

    vyber(tiles[0]);
  })();
</script>

{% schema %}
{
  "name": "Offside — Komu fandíš",
  "tag": "section",
  "class": "offside-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Komu fandíš?" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Kolekce s náramky",
      "info": "Každý produkt v kolekci se zobrazí jako jeden klub."
    },
    {
      "type": "range",
      "id": "max_products",
      "min": 4,
      "max": 24,
      "step": 1,
      "label": "Kolik klubů zobrazit",
      "default": 12
    },
    { "type": "text", "id": "button_label", "label": "Text tlačítka", "default": "Koupit" },
    {
      "type": "text",
      "id": "note",
      "label": "Popisek pod názvem",
      "default": "Ruční výroba · univerzální i na míru"
    },
    { "type": "header", "content": "Barvy, když produkt nemá metafieldy" },
    { "type": "color", "id": "default_from", "label": "Přechod — začátek", "default": "#b01e28" },
    { "type": "color", "id": "default_to", "label": "Přechod — konec", "default": "#340a0e" },
    { "type": "color", "id": "accent", "label": "Akcentní barva", "default": "#ec0016" }
  ],
  "presets": [{ "name": "Offside — Komu fandíš" }]
}
{% endschema %}
