{%- comment -%}
  OffsideStore — KOMU FANDÍŠ
  Dlazdice klubu. Kazdy klub je blok, takze se da pridat, smazat i pretahnout
  a ma vlastni zkratku, nazev, dve barvy prechodu a odkaz. Kliknuti na dlazdici
  prepne panel pod mrizkou (nazev + odkaz na koupi) a akcentni barvu sekce.
{%- endcomment -%}

{{ 'offside.css' | asset_url | stylesheet_tag }}

<section
  class="os os-section"
  id="os-kluby-{{ section.id }}"
  data-os-kluby
  style="--os-accent: {{ section.settings.accent }};"
>
  <div class="os__wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="os__display os__h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="os-kluby__grid">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="os-klub"
            {{ block.shopify_attributes }}
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            data-os-klub
            data-accent="{{ block.settings.color_from }}"
            data-name="{{ block.settings.name | escape }}"
            data-abbr="{{ block.settings.abbr | escape }}"
            data-url="{{ block.settings.link }}"
            data-note="{{ block.settings.note | escape }}"
            style="background: linear-gradient(135deg, {{ block.settings.color_from }} 0%, {{ block.settings.color_to }} 100%); color: {{ block.settings.ink }};"
          >
            <span class="os-klub__abbr">{{ block.settings.abbr }}</span>
            <span class="os-klub__name">{{ block.settings.name }}</span>
          </button>
        {%- endfor -%}
      </div>

      {%- assign prvni = section.blocks.first -%}
      <div class="os-kluby__panel">
        <div>
          <p class="os-kluby__panel-name" data-os-panel-name>{{ prvni.settings.name }}</p>
          <p class="os-kluby__panel-note" data-os-panel-note>{{ prvni.settings.note }}</p>
        </div>
        {%- if section.settings.button_label != blank -%}
          <a
            class="os__btn os__btn--accent"
            data-os-panel-link
            href="{{ prvni.settings.link | default: '#' }}"
          >
            <span data-os-panel-button>
              {{ section.settings.button_label }} {{ prvni.settings.abbr }}
            </span>
          </a>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="os-produkty__empty">
        Přidej kluby přes „Přidat blok" v nastavení sekce vlevo.
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('os-kluby-{{ section.id }}');
    if (!root) return;

    var tiles = root.querySelectorAll('[data-os-klub]');
    var name = root.querySelector('[data-os-panel-name]');
    var note = root.querySelector('[data-os-panel-note]');
    var link = root.querySelector('[data-os-panel-link]');
    var buttonText = root.querySelector('[data-os-panel-button]');
    var buttonLabel = {{ section.settings.button_label | default: 'Koupit' | json }};
  /**
     * Vrati #000 nebo #fff podle toho, co je na dane barve citelnejsi.
     * Zlute a svetle klubove barvy jinak dostaly bily text a nebyly videt.
     */
    function textNaBarve(hex) {
      var m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex || "");
      if (!m) return "#ffffff";
      var r = parseInt(m[1], 16),
        g = parseInt(m[2], 16),
        b = parseInt(m[3], 16);
      // Relativni jas podle WCAG, zjednodusene.
      var jas = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
      return jas > 0.6 ? "#0a0a0a" : "#ffffff";
    }

    tiles.forEach(function (tile) {
      tile.addEventListener('click', function () {
        tiles.forEach(function (t) {
          t.setAttribute('aria-pressed', 'false');
        });
        tile.setAttribute('aria-pressed', 'true');

        var akcent = tile.dataset.accent || '#ec0016';
        root.style.setProperty('--os-accent', akcent);
        root.style.setProperty('--os-on-accent', textNaBarve(akcent));
        if (name) name.textContent = tile.dataset.name || '';
        if (note) note.textContent = tile.dataset.note || '';
        if (link) link.setAttribute('href', tile.dataset.url || '#');
        if (buttonText) {
          buttonText.textContent = buttonLabel + ' ' + (tile.dataset.abbr || '');
        }
      });
    });
  })();
</script>

