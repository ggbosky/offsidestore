{%- comment -%}
  OffsideStore — STRÁNKA PRÁVNÍ ZÁSADY

  Text zasad si obsluha obchodu obvykle vklada z Wordu nebo Dokumentu.
  S textem se pritom prilepi i barvy pismen, ktere pocitaly s bilym
  papirem — na tmavem pozadi je pak text skoro neviditelny. Barvy proto
  uvnitr prebijeme, vcetne tech zapsanych primo ve znacce.

  Nazev se bere z mapy v nastaveni, protoze Shopify pojmenovava zasady
  podle jazyka obchodu a vracelo by "Terms of service".
{%- endcomment -%}

{{ 'offside.css' | asset_url | stylesheet_tag }}
{{ 'offside-stranky.css' | asset_url | stylesheet_tag }}

{%- capture nazev -%}
  {%- render 'os-nazev-zasady', zasada: policy, mapa: section.settings.policy_names -%}
{%- endcapture -%}
{%- assign nazev = nazev | strip -%}

<section class="os os-section" style="--os-accent: {{ section.settings.accent }};">
  <div class="os__wrap os-stranka">
    <nav class="os-drobecky" aria-label="Drobečková navigace">
      <a href="{{ routes.root_url }}">Domů</a>
      <span>/</span>
      <span class="os-drobecky__tady">{{ nazev }}</span>
    </nav>

    {%- if section.settings.eyebrow != blank -%}
      <p class="os-stranka__stitek">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="os__display os__h2">{{ nazev }}</h1>

    {%- if section.settings.intro != blank -%}
      <div class="os__lead">{{ section.settings.intro }}</div>
    {%- endif -%}

    <div class="os-stranka__obsah os-zasady__telo">
      {{ policy.body }}
    </div>

    {%- if section.settings.back_label != blank -%}
      <p class="os-zasady__zpet">
        <a href="{{ section.settings.back_link | default: routes.root_url }}">
          &larr; {{ section.settings.back_label }}
        </a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Offside — Právní zásady",
  "tag": "section",
  "class": "offside-section",
  "settings": [
    {
      "type": "textarea",
      "id": "policy_names",
      "label": "České názvy zásad",
      "info": "Jeden řádek ve tvaru: handle | Název. Použije se pro nadpis stránky. Handle poznáš z adresy, např. /policies/terms-of-service.",
      "default": "terms-of-service | Obchodní podmínky\nrefund-policy | Vrácení a reklamace\nshipping-policy | Doprava a doručení\nprivacy-policy | Ochrana osobních údajů\ncontact-information | Kontaktní údaje\nlegal-notice | Právní upozornění"
    },
    { "type": "text", "id": "eyebrow", "label": "Štítek nad nadpisem", "default": "Zákazník" },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Perex",
      "info": "Nepovinný text nad obsahem zásady."
    },
    { "type": "header", "content": "Odkaz zpět" },
    { "type": "text", "id": "back_label", "label": "Text odkazu", "default": "Zpět na úvod" },
    { "type": "url", "id": "back_link", "label": "Cíl odkazu" },
    { "type": "color", "id": "accent", "label": "Akcentní barva", "default": "#ec0016" }
  ]
}
{% endschema %}
