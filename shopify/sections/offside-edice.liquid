{%- comment -%}
  OffsideStore — HOTOVÉ EDICE
  Vypisuje skutecne produkty z kolekce vybrane v editoru motivu. Kdyz do
  kolekce pridas produkt v adminu, objevi se tady sam. Nazev sekce, odkaz
  vpravo, pocet produktu, pocet sloupcu i pas s fotkou se daji nastavit.
{%- endcomment -%}

{{ 'offside.css' | asset_url | stylesheet_tag }}

{%- assign kolekce = section.settings.collection -%}

<section
  class="os os-section"
  style="--os-accent: {{ section.settings.accent }}; --os-cols: {{ section.settings.columns }};"
>
  <div class="os__wrap">
    <div class="os-section__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="os__display os__h2">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.link_label != blank -%}
        <a class="os-section__link" href="{{ section.settings.link_url | default: kolekce.url | default: '#' }}">
          {{ section.settings.link_label }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.show_banner -%}
      <div class="os-banner">
        {%- if section.settings.banner != blank -%}
          {{
            section.settings.banner
            | image_url: width: 2000
            | image_tag:
              loading: 'lazy',
              sizes: '(max-width: 1400px) 100vw, 1336px',
              widths: '640, 960, 1280, 1600, 2000',
              alt: section.settings.banner.alt | default: section.settings.heading
          }}
        {%- else -%}
          <img
            src="{{ 'os-banner.jpg' | asset_url }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            width="1242"
            height="1656"
          >
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if kolekce != blank and kolekce.products_count > 0 -%}
      <div class="os-produkty">
        {%- for product in kolekce.products limit: section.settings.products_count -%}
          <a class="os-produkt" href="{{ product.url }}">
            <div class="os-produkt__media">
              {%- if product.featured_image -%}
                {{
                  product.featured_image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw',
                    widths: '300, 500, 700, 800',
                    alt: product.featured_image.alt | default: product.title
                }}
              {%- else -%}
                {%- comment -%}
                  Produkt bez fotky — misto prazdneho mista ukazeme zkratku.
                  Bere se z metafieldu custom.club_abbr, jinak z nazvu.
                {%- endcomment -%}
                {%- assign zkratka = product.metafields.custom.club_abbr -%}
                {%- if zkratka == blank -%}
                  {%- assign zkratka = product.title | split: ' ' | last | slice: 0, 3 -%}
                {%- endif -%}
                <span class="os-produkt__placeholder">{{ zkratka | upcase }}</span>
              {%- endif -%}
            </div>

            <div class="os-produkt__body">
              <div>
                <h3 class="os-produkt__title">{{ product.title }}</h3>
                {%- if product.type != blank -%}
                  <p class="os-produkt__meta">{{ product.type }}</p>
                {%- endif -%}
              </div>

              <div class="os-produkt__foot">
                {%- if section.settings.show_price -%}
                  <span class="os-produkt__price">
                    {%- if product.price_varies -%}
                      od {{ product.price_min | money }}
                    {%- else -%}
                      {{ product.price | money }}
                    {%- endif -%}
                  </span>
                {%- else -%}
                  <span></span>
                {%- endif -%}
                <span class="os-produkt__more">Detail &rarr;</span>
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="os-produkty__empty">
        {%- if kolekce == blank -%}
          Vyber kolekci v nastavení sekce vlevo. Produkty z ní se tu zobrazí samy.
        {%- else -%}
          Kolekce „{{ kolekce.title }}" zatím nemá žádné produkty.
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Offside — Hotové edice",
  "tag": "section",
  "class": "offside-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Nadpis",
      "default": "Hotové edice"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Kolekce s produkty",
      "info": "Produkty se berou odtud. Co přidáš do kolekce v adminu, objeví se i tady."
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Kolik produktů zobrazit",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Sloupců na počítači",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Zobrazit cenu",
      "default": true
    },
    {
      "type": "header",
      "content": "Odkaz vpravo nahoře"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Text odkazu",
      "default": "Všechny kluby →"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Odkaz",
      "info": "Když necháš prázdné, odkazuje na vybranou kolekci."
    },
    {
      "type": "header",
      "content": "Pás s fotkou nad produkty"
    },
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Zobrazit pás s fotkou",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "banner",
      "label": "Fotka",
      "info": "Když nevybereš, použije se fotka dodaná s motivem."
    },
    {
      "type": "header",
      "content": "Barvy"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Akcentní barva",
      "default": "#ec0016"
    }
  ],
  "presets": [
    {
      "name": "Offside — Hotové edice"
    }
  ]
}
{% endschema %}
