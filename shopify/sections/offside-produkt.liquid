{%- comment -%}
  OffsideStore — PRODUKTOVÁ STRÁNKA

  Klubovy naramek je hotovy kus — nic se na nem nenastavuje. Velikost je
  univerzalni (posuvny uzel), takze stranka ukazuje jednu fotku, popis
  a tlacitko do kosiku. Nic vic.

  Personalizace (barva, pismena) zije jen v konfiguratoru na uvodni strance.
{%- endcomment -%}

{%- assign zkratka = product.metafields.custom.club_abbr -%}
{%- if zkratka == blank -%}
  {%- assign zkratka = product.title | split: ' ' | last | slice: 0, 3 -%}
{%- endif -%}

<section class="os os-produkt-detail" style="--os-accent: {{ section.settings.accent }};">
  <div class="os__wrap">
    <nav class="os-drobecky" aria-label="Drobečková navigace">
      <a href="{{ routes.root_url }}">Domů</a>
      <span>/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span>/</span>
      {%- endif -%}
      <span class="os-drobecky__tady">{{ product.title }}</span>
    </nav>

    <div class="os-detail">
      {%- comment -%}
        Jedna fotka, cela — nic se neorezava. Kdyz produkt jeste nema vlastni
        fotku, vezme se vychozi z nastaveni sekce.
      {%- endcomment -%}
      <div class="os-detail__galerie">
        <div class="os-galerie__hlavni">
          {%- if product.featured_image -%}
            {{
              product.featured_image
              | image_url: width: 1400
              | image_tag:
                loading: 'eager',
                sizes: '(max-width: 1024px) 100vw, 55vw',
                widths: '500, 800, 1100, 1400',
                alt: product.featured_image.alt | default: product.title
            }}
          {%- elsif section.settings.fallback_image != blank -%}
            {{
              section.settings.fallback_image
              | image_url: width: 1400
              | image_tag:
                loading: 'eager',
                sizes: '(max-width: 1024px) 100vw, 55vw',
                widths: '500, 800, 1100, 1400',
                alt: product.title
            }}
          {%- else -%}
            <img src="{{ 'os-hero.jpg' | asset_url }}" alt="{{ product.title | escape }}" loading="eager">
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Nakupni box {%- endcomment -%}
      <div class="os-detail__box">
        <p class="os-detail__stitek">
          {%- if product.vendor != blank -%}{{ product.vendor }} · {% endif -%}
          {{ zkratka | upcase }}
        </p>

        <h1 class="os__display os-detail__nazev">{{ product.title }}</h1>

        <div class="os-detail__cena-radek">
          <span class="os-detail__cena">{{ product.price | money }}</span>
        </div>

        <div class="os-detail__odznaky">
          <span>{% if product.available %}Skladem{% else %}Vyprodáno{% endif %}</span>
          <span>Univerzální velikost</span>
          <span>Ruční výroba</span>
        </div>

        {%- if product.description != blank -%}
          <div class="os-detail__popis">{{ product.description }}</div>
        {%- endif -%}

        {%- comment -%}
          Bezny Shopify formular — funguje i bez JavaScriptu. Varianta je
          jedna, univerzalni, takze zadny vyber.
        {%- endcomment -%}
        <div class="os-detail__koupit">
          {%- form 'product', product, id: 'os-form', class: 'os-detail__form' -%}
            <input
              type="hidden"
              name="id"
              value="{{ product.selected_or_first_available_variant.id }}"
            >

            <button
              type="submit"
              name="add"
              class="os__btn os__btn--accent os-detail__do-kosiku"
              {% unless product.available %}disabled{% endunless %}
            >
              {%- if product.available -%}Přidat do košíku{%- else -%}Vyprodáno{%- endif -%}
            </button>
          {%- endform -%}

          <p class="os-konf__poznamka">
            {{ section.settings.note }}
          </p>
        </div>
      </div>
    </div>

    {%- comment -%} Detaily {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <section class="os-detail__sekce">
        <div class="os-detail__dvojice">
          <div>
            <h2 class="os__display os-detail__podnadpis">Detaily</h2>
            <p class="os-detail__uvod">
              Každý náramek je kompletovaný ručně. Drobné odchylky v zapletení
              jsou znakem toho, že ho dělal člověk.
            </p>
          </div>
          <dl class="os-detail__tabulka">
            {%- for block in section.blocks -%}
              <div {{ block.shopify_attributes }}>
                <dt>{{ block.settings.term }}</dt>
                <dd>{{ block.settings.value }}</dd>
              </div>
            {%- endfor -%}
          </dl>
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} Dalsi produkty {%- endcomment -%}
    {%- assign dalsi = section.settings.related_collection -%}
    {%- if dalsi != blank and dalsi.products_count > 1 -%}
      <section class="os-detail__sekce">
        <h2 class="os__display os-detail__podnadpis">Další kluby</h2>
        <div class="os-produkty" style="--os-cols: 4">
          {%- assign vypsano = 0 -%}
          {%- for p in dalsi.products -%}
            {%- if p.id != product.id and vypsano < 4 -%}
              {%- assign vypsano = vypsano | plus: 1 -%}
              <a class="os-produkt" href="{{ p.url }}">
                <div class="os-produkt__media">
                  {%- if p.featured_image -%}
                    {{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: p.title }}
                  {%- elsif section.settings.fallback_image != blank -%}
                    {{ section.settings.fallback_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: p.title }}
                  {%- else -%}
                    <img src="{{ 'os-hero.jpg' | asset_url }}" alt="{{ p.title | escape }}" loading="lazy">
                  {%- endif -%}
                </div>
                <div class="os-produkt__body">
                  <h3 class="os-produkt__title">{{ p.title }}</h3>
                  <div class="os-produkt__foot">
                    <span class="os-produkt__price">{{ p.price | money }}</span>
                    <span class="os-produkt__more">Detail &rarr;</span>
                  </div>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Offside — Produkt",
  "tag": "section",
  "class": "offside-section",
  "settings": [
    {
      "type": "collection",
      "id": "related_collection",
      "label": "Kolekce pro „Další kluby“"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Výchozí fotka",
      "info": "Ukáže se, dokud produkt nemá vlastní fotku. Prázdné = fotka náramků na zdí."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Poznámka pod tlačítkem",
      "default": "Univerzální velikost s posuvným uzlem · ruční výroba v Česku"
    },
    { "type": "color", "id": "accent", "label": "Akcentní barva", "default": "#ec0016" }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Řádek detailu",
      "settings": [
        { "type": "text", "id": "term", "label": "Název", "default": "Materiál" },
        { "type": "text", "id": "value", "label": "Hodnota", "default": "Originální hokejová tkanička" }
      ]
    }
  ],
  "max_blocks": 10
}
{% endschema %}
