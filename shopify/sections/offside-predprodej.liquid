{%- comment -%}
  OffsideStore — PŘEDPRODEJ

  Oznami, ze bezi predprodej, a ukaze, o co jde. Stoji hned pod herem,
  protoze je to docasna vec, ktera ma byt videt driv nez cokoliv jineho.

  Dva rezimy, podle toho, jak daleko je obchod:

  1. Kdyz vyberes kolekci, vykresli se produkty z ni — fotka, nazev,
     cena a proklik. Tohle chces, jakmile mas produkty v Shopify.
  2. Dokud kolekce neni, vykresli se bloky s promo vizualy. Ty uz maji
     cenu vypalenou primo v obrazku, takze se pod ne cena nepise znovu.

  Datum konce se zadava jako RRRR-MM-DD. Odpocet dopocita prohlizec;
  bez JavaScriptu zustane videt aspon samotne datum. Po terminu se
  misto odpoctu objevi, ze predprodej skoncil — at tam nestrasi lhani
  o case, ktery uz vyprsel.
{%- endcomment -%}

{{ 'offside.css' | asset_url | stylesheet_tag }}

{%- assign kolekce = section.settings.collection -%}

<section
  class="os os-section os-predprodej"
  id="os-predprodej"
  style="--os-accent: {{ section.settings.accent }}; --os-on-accent: {{ section.settings.accent_text }};"
>
  <div class="os__wrap">
    <div class="os-predprodej__hlava">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="os-predprodej__stitek">
            <span class="os-predprodej__tecka" aria-hidden="true"></span>
            {{ section.settings.eyebrow }}
          </p>
        {%- endif -%}

        <h2 class="os__display os__h2">
          {{ section.settings.heading_1 }}
          {%- if section.settings.heading_2 != blank -%}
            <span class="os__accent-text" style="display:block">{{ section.settings.heading_2 }}</span>
          {%- endif -%}
        </h2>

        {%- if section.settings.text != blank -%}
          <div class="os__lead">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.end_date != blank -%}
        <div class="os-predprodej__termin" data-os-termin="{{ section.settings.end_date }}">
          <p class="os-predprodej__termin-popis">{{ section.settings.end_label }}</p>
          <p class="os-predprodej__termin-datum">
            {{ section.settings.end_date | date: '%-d. %-m. %Y' }}
          </p>
          <p class="os-predprodej__odpocet" data-os-odpocet hidden></p>
        </div>
      {%- endif -%}
    </div>

    {%- if kolekce != blank and kolekce.products_count > 0 -%}
      {%- comment -%} Ostry rezim: produkty z obchodu. {%- endcomment -%}
      <div class="os-predprodej__mrizka">
        {%- for produkt in kolekce.products limit: section.settings.max_products -%}
          <a class="os-predprodej__kus" href="{{ produkt.url }}">
            <div class="os-predprodej__media">
              {%- if produkt.featured_image -%}
                {{
                  produkt.featured_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw',
                    widths: '300, 500, 700, 900',
                    alt: produkt.featured_image.alt | default: produkt.title
                }}
              {%- endif -%}
              {%- unless produkt.available -%}
                <span class="os-predprodej__znak">Vyprodáno</span>
              {%- endunless -%}
            </div>
            <div class="os-predprodej__popis">
              <h3 class="os-predprodej__nazev">{{ produkt.title }}</h3>
              <span class="os-predprodej__cena">{{ produkt.price | money }}</span>
            </div>
          </a>
        {%- endfor -%}
      </div>

    {%- elsif section.blocks.size > 0 -%}
      {%- comment -%}
        Nahledovy rezim: promo vizualy. Cena uz je v obrazku, nepiseme ji
        pod nej podruhe.
      {%- endcomment -%}
      <div class="os-predprodej__mrizka">
        {%- for block in section.blocks -%}
          {%- capture obsah -%}
            <div class="os-predprodej__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw',
                    widths: '300, 500, 700, 900',
                    alt: block.settings.title
                }}
              {%- else -%}
                <img
                  src="{{ block.settings.fallback | default: 'os-predprodej-1.jpg' | asset_url }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="1080"
                  height="1350"
                >
              {%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}
              <div class="os-predprodej__popis">
                <h3 class="os-predprodej__nazev">{{ block.settings.title }}</h3>
              </div>
            {%- endif -%}
          {%- endcapture -%}

          {%- if block.settings.link != blank -%}
            <a class="os-predprodej__kus" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              {{ obsah }}
            </a>
          {%- else -%}
            <div class="os-predprodej__kus" {{ block.shopify_attributes }}>
              {{ obsah }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if request.design_mode and kolekce == blank -%}
        <p class="os-konf__upozorneni">
          Tohle jsou zatím jen obrázky. Jakmile přidáš čepice do Shopify
          a vybereš tu kolekci v nastavení sekce, nahradí se produkty,
          které jdou rovnou koupit. Upozornění vidíš jen ty v editoru.
        </p>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="os__buttons os-predprodej__akce">
        <a class="os__btn os__btn--accent" href="{{ section.settings.button_link | default: '#' }}">
          {{ section.settings.button_label }}
        </a>
        {%- if section.settings.note != blank -%}
          <p class="os-predprodej__pozn">{{ section.settings.note }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var box = document.querySelector('[data-os-termin]');
    if (!box) return;

    var cil = new Date(box.getAttribute('data-os-termin') + 'T23:59:59');
    if (isNaN(cil)) return;

    var vypis = box.querySelector('[data-os-odpocet]');
    if (!vypis) return;

    function sklonujDny(n) {
      if (n === 1) return '1 den';
      if (n < 5) return n + ' dny';
      return n + ' dnů';
    }

    function prekresli() {
      var zbyva = cil - new Date();

      if (zbyva <= 0) {
        vypis.textContent = 'Předprodej skončil';
        vypis.hidden = false;
        return;
      }

      var dny = Math.floor(zbyva / 86400000);
      var hodiny = Math.floor((zbyva % 86400000) / 3600000);

      vypis.textContent = dny > 0
        ? 'zbývá ' + sklonujDny(dny)
        : 'zbývá ' + hodiny + ' h';
      vypis.hidden = false;
    }

    prekresli();
    setInterval(prekresli, 60000);
  })();
</script>

{% schema %}
{
  "name": "Offside — Předprodej",
  "tag": "section",
  "class": "offside-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Štítek nad nadpisem", "default": "Právě běží" },
    { "type": "text", "id": "heading_1", "label": "Nadpis — první řádek", "default": "Spustili jsme" },
    { "type": "text", "id": "heading_2", "label": "Nadpis — barevný řádek", "default": "předprodej." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text pod nadpisem",
      "default": "<p>Nová kolekce čepic a kšiltovek. Objednávej teď v předprodeji — po termínu se dělá jen to, co je objednané.</p>"
    },
    { "type": "header", "content": "Termín" },
    {
      "type": "text",
      "id": "end_date",
      "label": "Konec předprodeje",
      "default": "2026-12-10",
      "info": "Ve tvaru RRRR-MM-DD. Odpočet se dopočítá sám a po termínu se místo něj zobrazí, že předprodej skončil."
    },
    { "type": "text", "id": "end_label", "label": "Popisek u data", "default": "Konec předprodeje" },
    { "type": "header", "content": "Produkty" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Kolekce s předprodejem",
      "info": "Když ji vybereš, zobrazí se produkty z obchodu místo obrázků níže."
    },
    {
      "type": "range",
      "id": "max_products",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Kolik produktů zobrazit",
      "default": 8
    },
    { "type": "header", "content": "Tlačítko" },
    { "type": "text", "id": "button_label", "label": "Text tlačítka", "default": "Chci je" },
    { "type": "url", "id": "button_link", "label": "Cíl tlačítka" },
    {
      "type": "text",
      "id": "note",
      "label": "Poznámka pod tlačítkem",
      "default": "Předprodejní cena platí do konce termínu."
    },
    { "type": "color", "id": "accent", "label": "Akcentní barva", "default": "#ec0016" },
    { "type": "color", "id": "accent_text", "label": "Text na akcentu", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "vizual",
      "name": "Obrázek produktu",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Fotka" },
        {
          "type": "text",
          "id": "fallback",
          "label": "Záložní soubor z assets",
          "info": "Použije se, dokud nevybereš fotku. Např. os-predprodej-1.jpg"
        },
        { "type": "text", "id": "title", "label": "Popisek pod fotkou" },
        { "type": "url", "id": "link", "label": "Odkaz" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Offside — Předprodej" }]
}
{% endschema %}
