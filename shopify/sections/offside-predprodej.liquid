{%- comment -%}
  OffsideStore — PŘEDPRODEJ

  Oznami, ze bezi predprodej. Stoji hned pod herem, protoze je to docasna
  vec, ktera ma byt videt driv nez cokoliv jineho.

  Hlavni je pas pres celou sirku okna. Cely je prokliknutelny na kolekci,
  takze slouzi zaroven jako tlacitko.

  Text nad nim schvalne zustava i kdyz uz ho pas obsahuje: pas ma pomer
  skoro 2,4:1, takze na telefonu vyjde nizky a pismo v nem necitelne.
  Nadpis, termin a odpocet jsou proto psane HTML a daji se precist
  v jakekoliv sirce.

  Odpocet dopocita prohlizec z data v nastaveni. Po terminu se misto nej
  objevi, ze predprodej skoncil — slibovat cas, ktery uz vyprsel, by bylo
  horsi nez neukazat nic.
{%- endcomment -%}

{{ 'offside.css' | asset_url | stylesheet_tag }}

{%- assign cil = section.settings.link | default: '/collections/all' -%}

<section
  class="os os-section os-predprodej{% if section.settings.hide_text_desktop %} os-predprodej--bez-textu{% endif %}"
  id="os-predprodej"
  style="--os-accent: {{ section.settings.accent }}; --os-on-accent: {{ section.settings.accent_text }};"
>
  {%- comment -%}
    Na velkych obrazovkach rika tohle same uz pas, takze by se text
    opakoval dvakrat pod sebou. Na telefonu je ale pas nizky a pismo
    v nem necitelne, proto tu text zustava — jen se nad danou sirkou
    schova.
  {%- endcomment -%}
  <div class="os__wrap">
    <div class="os-predprodej__hlava{% if section.settings.hide_text_desktop %} os-predprodej__hlava--jen-uzke{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="os-predprodej__stitek">
          <span class="os-predprodej__tecka" aria-hidden="true"></span>
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading_1 != blank or section.settings.heading_2 != blank -%}
        <h2 class="os__display os__h2">
          {{ section.settings.heading_1 }}
          {%- if section.settings.heading_2 != blank -%}
            <span class="os__accent-text" style="display:block">{{ section.settings.heading_2 }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="os__lead">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%}
    Pas zamerne lezi mimo os__wrap, aby sel od kraje ke kraji okna.
  {%- endcomment -%}
  <a class="os-predprodej__pas" href="{{ cil }}">
    {%- if section.settings.banner != blank -%}
      {{
        section.settings.banner
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          sizes: '100vw',
          widths: '640, 960, 1280, 1600, 2000, 2400',
          alt: section.settings.banner_alt
      }}
    {%- else -%}
      <img
        src="{{ 'os-predprodej-pas.webp' | asset_url }}"
        alt="{{ section.settings.banner_alt | escape }}"
        loading="lazy"
        width="1024"
        height="434"
      >
    {%- endif -%}
  </a>

  <div class="os__wrap">
    <div class="os-predprodej__akce">
      <a class="os__btn os__btn--accent" href="{{ cil }}">
        {{ section.settings.button_label | default: 'Chci je' }}
      </a>

      {%- comment -%}
        Odpocet stoji u tlacitka, protoze je to jedina vec, kterou pas
        rict neumi — datum uz v nem vytisknute je.
      {%- endcomment -%}
      {%- if section.settings.end_date != blank -%}
        <p class="os-predprodej__termin" data-os-termin="{{ section.settings.end_date }}">
          <span class="os-predprodej__termin-popis">{{ section.settings.end_label }}</span>
          <span class="os-predprodej__termin-datum">
            {{- section.settings.end_date | date: '%-d. %-m. %Y' -}}
          </span>
          <span class="os-predprodej__odpocet" data-os-odpocet hidden></span>
        </p>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="os-predprodej__pozn">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>

    {%- if request.design_mode and section.settings.link == blank -%}
      <p class="os-konf__upozorneni">
        Pás i tlačítko zatím míří na <code>/collections/all</code>. Založ
        kolekci s předprodejem a vyber ji v nastavení sekce (<em>Kam vede
        proklik</em>). Upozornění vidíš jen ty v editoru motivu.
      </p>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var box = document.querySelector('[data-os-termin]');
    if (!box) return;

    var cil = new Date(box.getAttribute('data-os-termin') + 'T23:59:59');
    if (isNaN(cil)) return;

    var vypis = box.querySelector('[data-os-odpocet]');
    if (!vypis) return;

    function sklonujDny(n) {
      if (n === 1) return '1 den';
      if (n < 5) return n + ' dny';
      return n + ' dnů';
    }

    function prekresli() {
      var zbyva = cil - new Date();

      if (zbyva <= 0) {
        vypis.textContent = 'Předprodej skončil';
        vypis.hidden = false;
        return;
      }

      var dny = Math.floor(zbyva / 86400000);
      var hodiny = Math.floor((zbyva % 86400000) / 3600000);

      vypis.textContent = dny > 0
        ? 'zbývá ' + sklonujDny(dny)
        : 'zbývá ' + hodiny + ' h';
      vypis.hidden = false;
    }

    prekresli();
    setInterval(prekresli, 60000);
  })();
</script>

{% schema %}
{
  "name": "Offside — Předprodej",
  "tag": "section",
  "class": "offside-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection_hint",
      "label": "Kolekce s předprodejem",
      "info": "Jen pro přehled. Cíl prokliku nastav níž."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Kam vede proklik",
      "info": "Pás i tlačítko. Bez vyplnění míří na /collections/all."
    },
    { "type": "header", "content": "Pás přes celou šířku" },
    { "type": "image_picker", "id": "banner", "label": "Grafika", "info": "Prázdné = přiložený pás z motivu. Ať je široká aspoň 2000 px, jinak bude na velkých obrazovkách měkká." },
    {
      "type": "text",
      "id": "banner_alt",
      "label": "Popis grafiky",
      "default": "Spustili jsme předprodej exkluzivního merche, konec 10. 12. 2026",
      "info": "Přečte ho hlasový odečítač a zobrazí se, když se obrázek nenačte."
    },
    { "type": "header", "content": "Text nad pásem" },
    {
      "type": "checkbox",
      "id": "hide_text_desktop",
      "label": "Na velkých obrazovkách text skrýt",
      "default": true,
      "info": "Tam už to samé říká pás. Na telefonu text zůstává, protože v pásu je písmo malé."
    },
    { "type": "text", "id": "eyebrow", "label": "Štítek", "default": "Právě běží" },
    { "type": "text", "id": "heading_1", "label": "Nadpis — první řádek", "default": "Spustili jsme" },
    { "type": "text", "id": "heading_2", "label": "Nadpis — barevný řádek", "default": "předprodej." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text pod nadpisem",
      "default": "<p>Exkluzivní merch — čepice a kšiltovky. Objednávej teď v předprodeji, po termínu se dělá jen to, co je objednané.</p>"
    },
    { "type": "header", "content": "Termín" },
    {
      "type": "text",
      "id": "end_date",
      "label": "Konec předprodeje",
      "default": "2026-12-10",
      "info": "Ve tvaru RRRR-MM-DD. Odpočet se dopočítá sám a po termínu se místo něj zobrazí, že předprodej skončil."
    },
    { "type": "text", "id": "end_label", "label": "Popisek u data", "default": "Konec předprodeje" },
    { "type": "header", "content": "Tlačítko" },
    { "type": "text", "id": "button_label", "label": "Text tlačítka", "default": "Chci je" },
    {
      "type": "text",
      "id": "note",
      "label": "Poznámka pod tlačítkem",
      "default": "Předprodejní cena platí do konce termínu."
    },
    { "type": "color", "id": "accent", "label": "Akcentní barva", "default": "#ec0016" },
    { "type": "color", "id": "accent_text", "label": "Text na akcentu", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Offside — Předprodej" }]
}
{% endschema %}
