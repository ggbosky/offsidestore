{%- comment -%}
  OffsideStore — KONFIGURÁTOR

  Tri kroky: klub, barva tkanicky, pismena. Kdyz ma vybrany produkt vic
  variant, pribude ctvrty krok s velikosti — nabidka se bere primo z variant
  produktu, takze odpovida tomu, co je v obchode.

  Kluby se berou z kolekce, stejne jako v sekci Komu fandis. Zadne rucni
  vyplnovani bloku: co pridas do kolekce, objevi se tady.

  Cena: zaklad = cena varianty, kazdy znak nad tri = jeden kus produktu
  "priplatek za znak". Liquid cenu varianty prepsat neumi, tohle je jedina
  cesta, ktera funguje na vsech tarifech.
{%- endcomment -%}

{{ 'offside.css' | asset_url | stylesheet_tag }}

{%- assign kolekce = section.settings.collection -%}
{%- assign priplatek = section.settings.addon_product -%}
{%- assign cena_znaku = priplatek.price | default: 1200 -%}
{%- assign prvni = kolekce.products.first -%}
{%- assign zakladni_cena = prvni.price | default: 29000 -%}

<section
  class="os os-section"
  id="os-konfigurator"
  data-os-konfigurator
  style="--os-accent: {{ section.settings.accent }}; --os-on-accent: {{ section.settings.accent_text }};"
>
  <div class="os__wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="os__display os__h2">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="os__lead">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if kolekce == blank or kolekce.products_count == 0 -%}
      <div class="os-konf__chybi">
        <p class="os-konf__chybi-nadpis">Konfigurátor čeká na kolekci</p>
        <p>
          V nastavení sekce vlevo vyber kolekci s náramky. Každý produkt v ní
          bude jeden klub a konfigurátor se objeví sám.
        </p>
      </div>
    {%- else -%}
      <div class="os-konf">
        <div class="os-konf__nahled">
          <div class="os-konf__ramecek">
            <div class="os-konf__hlavicka">
              <span class="os-konf__stitek">Náhled živě</span>
              <span class="os-konf__klub" data-os-nazev-klubu></span>
            </div>

            <svg
              class="os-konf__naramek"
              viewBox="0 95 880 200"
              role="img"
              aria-label="Náhled náramku"
            >
              <defs>
                <linearGradient id="os-kov-{{ section.id }}" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#3a3a40" />
                  <stop offset="45%" stop-color="#232327" />
                  <stop offset="100%" stop-color="#16161a" />
                </linearGradient>
              </defs>
              <ellipse cx="440" cy="250" rx="318" ry="16" fill="#000" opacity="0.45" />
              <g data-os-prameny></g>
              <rect x="42" y="130" width="40" height="40" rx="12" fill="url(#os-kov-{{ section.id }})" stroke="#ffffff18" />
              <rect x="798" y="130" width="40" height="40" rx="12" fill="url(#os-kov-{{ section.id }})" stroke="#ffffff18" />
              <g data-os-pismena-svg></g>
            </svg>

            <dl class="os-konf__souhrn">
              <div>
                <dt>Zkratka</dt>
                <dd data-os-souhrn-zkratka>&mdash;</dd>
              </div>
              <div>
                <dt>Velikost</dt>
                <dd data-os-souhrn-velikost>&mdash;</dd>
              </div>
              <div>
                <dt>Barva</dt>
                <dd><span class="os-konf__tecka" data-os-souhrn-barva></span></dd>
              </div>
            </dl>
          </div>
        </div>

        <div class="os-konf__kroky">
          <ol class="os-konf__zalozky">
            <li>
              <button type="button" class="os-konf__zalozka" data-os-krok-tlacitko="1" aria-selected="true">
                1. Klub
              </button>
            </li>
            <li>
              <button type="button" class="os-konf__zalozka" data-os-krok-tlacitko="2" aria-selected="false">
                2. Barva
              </button>
            </li>
            <li>
              <button type="button" class="os-konf__zalozka" data-os-krok-tlacitko="3" aria-selected="false">
                3. Písmena
              </button>
            </li>
            <li data-os-zalozka-velikost hidden>
              <button type="button" class="os-konf__zalozka" data-os-krok-tlacitko="4" aria-selected="false">
                4. Velikost
              </button>
            </li>
          </ol>

          <div class="os-konf__panel" data-os-krok="1">
            <h3 class="os-konf__nadpis">Komu fandíš?</h3>
            <p class="os-konf__popis">
              Klub nastaví barvu tkaničky i výchozí zkratku. Obojí jde pak přepsat.
            </p>
            <div class="os-kluby__grid">
              {%- for produkt in kolekce.products limit: section.settings.max_products -%}
                {%- assign zkratka = produkt.metafields.custom.club_abbr -%}
                {%- if zkratka == blank -%}
                  {%- assign zkratka = produkt.title | split: ' ' | last | slice: 0, 3 -%}
                {%- endif -%}
                {%- assign od = produkt.metafields.custom.club_from | default: section.settings.default_from -%}
                {%- assign do = produkt.metafields.custom.club_to | default: section.settings.default_to -%}
                {%- assign inkoust = produkt.metafields.custom.club_ink | default: '#ffffff' -%}
                {%- assign tkanicka = produkt.metafields.custom.club_lace | default: od -%}

                <button
                  type="button"
                  class="os-klub{% if produkt.featured_image %} os-klub--foto{% endif %}"
                  data-os-klub
                  data-index="{{ forloop.index0 }}"
                  data-abbr="{{ zkratka | upcase | escape }}"
                  data-name="{{ produkt.title | escape }}"
                  data-lace="{{ tkanicka }}"
                  data-accent="{{ od }}"
                  aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                  style="background: linear-gradient(135deg, {{ od }} 0%, {{ do }} 100%); color: {{ inkoust }};"
                >
                  {%- if produkt.featured_image -%}
                    {{
                      produkt.featured_image
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        class: 'os-klub__foto',
                        sizes: '(max-width: 640px) 33vw, 200px',
                        widths: '200, 400, 600',
                        alt: produkt.title
                    }}
                  {%- else -%}
                    <span class="os-klub__abbr">{{ zkratka | upcase }}</span>
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          </div>

          <div class="os-konf__panel" data-os-krok="2" hidden>
            <h3 class="os-konf__nadpis">Barva tkaničky</h3>
            <p class="os-konf__popis">
              Náramek je z jedné tkaničky, takže i barva je jedna. Přednastavená
              je klubová — přepni ji, jak chceš.
            </p>
            <div class="os-konf__paleta">
              {%- assign barvy = section.settings.palette | split: ',' -%}
              {%- for barva in barvy -%}
                {%- assign hex = barva | strip -%}
                <button
                  type="button"
                  class="os-konf__barva"
                  data-os-barva="{{ hex }}"
                  aria-pressed="false"
                  aria-label="Barva {{ hex }}"
                  style="background: {{ hex }};"
                ></button>
              {%- endfor -%}
            </div>
            <button type="button" class="os-konf__odkaz" data-os-barva-reset>
              Zpět na klubovou
            </button>
          </div>

          <div class="os-konf__panel" data-os-krok="3" hidden>
            <h3 class="os-konf__nadpis">Písmena</h3>
            <p class="os-konf__popis">
              Tři znaky jsou v ceně. Každý další {{ cena_znaku | money }}.
            </p>
            <label class="os-konf__label" for="os-pismena-{{ section.id }}">
              Zkratka / nápis
            </label>
            <input
              id="os-pismena-{{ section.id }}"
              class="os-konf__input"
              type="text"
              maxlength="12"
              autocomplete="off"
              data-os-pismena
            >
            <p class="os-konf__napoveda" data-os-napoveda></p>
          </div>

          <div class="os-konf__panel" data-os-krok="4" hidden>
            <h3 class="os-konf__nadpis">Velikost</h3>
            <p class="os-konf__popis">
              Změř obvod zápěstí provázkem a přidej zhruba centimetr na volnost.
            </p>
            <div class="os-konf__volby os-konf__volby--tri" data-os-velikosti></div>
          </div>

          <div class="os-konf__souhrn-box">
            <dl class="os-konf__cena">
              <div>
                <dt>Základ (tkanička + 3 znaky)</dt>
                <dd data-os-cena-zaklad>{{ zakladni_cena | money }}</dd>
              </div>
              <div data-os-radek-znaku hidden>
                <dt data-os-popis-znaku></dt>
                <dd data-os-cena-navic></dd>
              </div>
              <div class="os-konf__cena-celkem">
                <dt>Celkem</dt>
                <dd data-os-cena-celkem>{{ zakladni_cena | money }}</dd>
              </div>
            </dl>

            <button type="button" class="os__btn os__btn--accent os-konf__koupit" data-os-pridat>
              <span data-os-popisek-tlacitka>Přidat do košíku</span>
            </button>

            <p class="os-konf__poznamka" data-os-stav>
              Ruční výroba v Česku · Termín odeslání potvrdíme e-mailem
            </p>
          </div>

          <div class="os-konf__navigace">
            <button type="button" class="os-konf__odkaz" data-os-zpet>&larr; Zpět</button>
            <button type="button" class="os-konf__odkaz" data-os-dale>Další &rarr;</button>
          </div>
        </div>
      </div>

      <a class="os-konf__plovouci" data-os-plovouci href="#os-konfigurator">
        <span data-os-popisek-plovouci>Přidat do košíku</span>
      </a>

      <script type="application/json" data-os-data>
        {
          "kluby": [
            {%- for produkt in kolekce.products limit: section.settings.max_products -%}
              {
                "nazev": {{ produkt.title | json }},
                "varianty": [
                  {%- for v in produkt.variants -%}
                    { "id": {{ v.id }}, "nazev": {{ v.title | json }}, "cena": {{ v.price }}, "skladem": {{ v.available }} }
                    {%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                ]
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ],
          "priplatekId": {% if priplatek.first_available_variant %}{{ priplatek.first_available_variant.id }}{% else %}null{% endif %},
          "cenaZnaku": {{ cena_znaku }},
          "mena": {{ section.settings.currency_suffix | json }},
          "znakyVCene": 3
        }
      </script>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'offside-konfigurator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Offside — Konfigurátor",
  "tag": "section",
  "class": "offside-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Nadpis",
      "default": "Vytvoř si svůj náramek"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text pod nadpisem",
      "default": "<p>Klub, barva, písmena. Cena se přepočítává v reálném čase — vidíš ji rovnou v tlačítku.</p>"
    },
    { "type": "header", "content": "Produkty" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Kolekce s náramky",
      "info": "Každý produkt v kolekci je jeden klub."
    },
    {
      "type": "range",
      "id": "max_products",
      "min": 4,
      "max": 24,
      "step": 1,
      "label": "Kolik klubů nabídnout",
      "default": 12
    },
    {
      "type": "product",
      "id": "addon_product",
      "label": "Příplatek za znak",
      "info": "Skrytý produkt za 12 Kč. Za každý znak nad tři se přidá jeden kus."
    },
    { "type": "text", "id": "currency_suffix", "label": "Zkratka měny", "default": "Kč" },
    { "type": "header", "content": "Barvy tkaniček" },
    {
      "type": "textarea",
      "id": "palette",
      "label": "Paleta",
      "info": "Barvy oddělené čárkou, formát #rrggbb.",
      "default": "#111111,#FFFFFF,#B01E28,#0B4EA2,#3FA9E0,#0F9D4F,#F2C300,#FF6B00,#C0C0C0,#7A4A2B"
    },
    { "type": "header", "content": "Barvy, když produkt nemá metafieldy" },
    { "type": "color", "id": "default_from", "label": "Přechod — začátek", "default": "#b01e28" },
    { "type": "color", "id": "default_to", "label": "Přechod — konec", "default": "#340a0e" },
    { "type": "color", "id": "accent", "label": "Akcentní barva", "default": "#ec0016" },
    { "type": "color", "id": "accent_text", "label": "Text na akcentní barvě", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Offside — Konfigurátor" }]
}
{% endschema %}
